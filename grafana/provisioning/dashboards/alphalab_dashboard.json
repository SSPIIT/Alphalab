{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.2" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "AlphaLab MLOps — API health, request metrics, and factor performance monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚀 API Health",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "expr": "up{job=\"alphalab_api\"}",
          "legendFormat": "API Status",
          "refId": "A"
        }
      ],
      "title": "API Status",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"alphalab_api\"}[5m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"alphalab_api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"alphalab_api\"}[5m]))",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "title": "Error Rate (5xx)",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"alphalab_api\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ],
      "title": "p95 Latency (ms)",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "expr": "sum(increase(predictions_total{job=\"alphalab_api\"}[24h]))",
          "legendFormat": "Predictions Today",
          "refId": "A"
        }
      ],
      "title": "Predictions (24h)",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📈 Request Metrics",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5xx errors" },
            "properties": [ { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } } ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"alphalab_api\"}[5m])) by (endpoint)",
          "legendFormat": "{{ endpoint }}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{job=\"alphalab_api\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx errors",
          "refId": "B"
        }
      ],
      "title": "Request Rate by Endpoint",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 7,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"alphalab_api\"}[5m])) by (le, endpoint)) * 1000",
          "legendFormat": "p50 {{ endpoint }}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"alphalab_api\"}[5m])) by (le, endpoint)) * 1000",
          "legendFormat": "p95 {{ endpoint }}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"alphalab_api\"}[5m])) by (le, endpoint)) * 1000",
          "legendFormat": "p99 {{ endpoint }}",
          "refId": "C"
        }
      ],
      "title": "Latency Percentiles by Endpoint (ms)",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "🧠 Factor Performance",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 8,
      "options": { "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "factor_score{job=\"alphalab_api\"}",
          "legendFormat": "{{ factor }}",
          "refId": "A"
        }
      ],
      "title": "Factor Scores (NRT)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 9,
      "options": { "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "drift_detection_psi_score{job=\"alphalab_api\"}",
          "legendFormat": "PSI {{ feature }}",
          "refId": "A"
        }
      ],
      "title": "Factor Drift (PSI Score) — threshold 0.2",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "🖥️ Infrastructure",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "id": 10,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": true },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "title": "CPU Usage %",
      "type": "gauge"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1073741824 },
              { "color": "red", "value": 2147483648 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "id": 11,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": true },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "RAM Used",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "type": "gauge"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.85 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "id": 12,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": true },
      "targets": [
        {
          "expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})",
          "legendFormat": "Disk Used %",
          "refId": "A"
        }
      ],
      "title": "Disk Usage %",
      "type": "gauge"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 104,
      "title": "🔔 Active Alerts",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "afkg3pvtckd8ge" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  { "options": { "critical": { "color": "red", "index": 0 }, "warning": { "color": "yellow", "index": 1 } }, "type": "value" }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 31 },
      "id": 13,
      "options": { "sortBy": [{ "desc": true, "displayName": "severity" }] },
      "targets": [
        {
          "expr": "ALERTS{job=\"alphalab_api\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "title": "Active Prometheus Alerts",
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": false, "__name__": true, "Value": true }, "renameByName": { "alertname": "Alert", "alertstate": "State", "severity": "Severity", "instance": "Instance" } } }
      ],
      "type": "table"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["alphalab", "mlops", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Kolkata",
  "title": "AlphaLab MLOps Dashboard",
  "uid": "alphalab-main",
  "version": 1
}